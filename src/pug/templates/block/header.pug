header.header-wrap#header-blk.js-head-scroll
  .container
    .header.js-head-scroll
      a.header_logo(href='./')
        img.header_logo-image(src='@img/logo.svg' alt='logo')
      .header_content.js-menu-content
        nav.header_nav
          if notLinkLogo == true
            a.header_item(data-goto="body" ) Home
            a.header_item(data-goto="about-us" ) About Us
            a.header_item(data-goto="catalog" ) Catalog
            a.header_item(data-goto="why-us" ) Why Us
            a.header_item(data-goto="contacts" ) Contacts
          else
            a.header_item(href='./') Home
            a.header_item(href='./#about-us') About Us
            a.header_item(href='./#catalog') Catalog
            a.header_item(href='./#why-us') Why Us
            a.header_item(href='./#contacts') Contacts
          .header_btn-block
            a.header_soc-link(target="_blank" href="https://www.facebook.com/")
              img.header_soc-icon.map_contact-icon--img(src="./images/icons/icons.svg#soc-fb")
            a.header_soc-link(target="_blank" href="https://www.youtube.com/")
              img.header_soc-icon.map_contact-icon--img(src="./images/icons/icons.svg#soc-yt")
      button.header_btn-menu.btn-base.js-btn-menu
      a.header_btn.header_btn--second.btn-base.js-head-cart-btn(href='/cart.html' data-cart="true")
        img.header_btn-img.cart-icon(src='./images/icons/icons.svg#heart')
        span.header_btn-count
          span.header_btn-num.js-head-cart-num 0
