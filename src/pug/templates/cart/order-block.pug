section.order-wrap#order-block
  .container
    .order
      .order_title.title-3 Contact Info
      form.form.order_form.js-form#order-form(action="/files/sendOrderSMTP.php", method="post")
        .form_field.form_field--mini
          label.form_label(for="emailPhone") Email/Tel
          input.form_inp#emailPhone(type="text" name="email" data-req="name" placeholder="Email/Tel")
        .form_field.form_field--mini
          label.form_label(for="Shipping") Shipping
          div.select-base
            select#Shipping(name="shipppingSelect")
              option(value="") Select
              option(value="EX Works, Riga (Latvia)") EX Works, Riga (Latvia)
              option(value="Delivery to my place") Delivery to my place
              
        .form_field
          label.form_label(for="orderMessage") Email/Tel
          textarea.form_inp#orderMessage.textarea-base(type="text" name="message" placeholder="Order comment" )
        .form_field.form_field--recap
          //- .form_grecaptcha.js-recaptcha#recaptcha-2(data-tabindex=1)
          button.form_btn.btn-base Send