section.shoping-wrap 
  .container
    .shoping_decor
      svg(width="1501" height="749" viewBox="0 0 1501 749" fill="none" xmlns="http://www.w3.org/2000/svg")
        path(d="M35.8171 430.224C137.866 613.583 1202.3 785.325 1301.47 741.076C1455.97 672.137 1610.09 141.56 1392.27 50.204C1298.01 10.6679 972.422 -10.3467 754.739 7.28077C532.065 25.3124 -163.595 71.9242 35.8171 430.224Z" fill="url(#paint0_linear_318_180)")
        defs
          linearGradient(id="paint0_linear_318_180" x1="932.652" y1="676.505" x2="969.992" y2="403.195" gradientUnits="userSpaceOnUse")
            stop(stop-color="white" stop-opacity="0.1")
            stop(offset="1" stop-color="white" stop-opacity="0.8")
    .shoping
      h2.shoping_title.title-3 Wishlist List
      table.table.cart-data_table
          thead.table_head
            tr.table_head-row
              th.table_head-cell.table_head-cell--start 
                span.table_head-caption Product photo
              th.table_head-cell.table_head-cell--name
                span.table_head-caption Description
              th.table_head-cell
                span.table_head-caption Gr.
              th.table_head-cell.table_head-cell--min
                span.table_head-caption Pcs/Pallet
              th.table_head-cell.table_head-cell--end
                span.table_head-caption Quant
          tbody.table_body
            tr.table_row.js-card-item-template.is-hidden(data-id='0')
              td.table_cell.table_cell--start(data-img='')
                img.table_cell-img.js-product-img(src='')
              td.table_cell.table_cell--name(data-name="Medical Cotton Zig-Zag")
                .table_cell-box
                  span.table_cell-name.js-product-name Medical Cotton Zig-Zag
                  p.table_cell-art(data-art="100")
                    span.table_cell-attr Art.  
                    span.table_cell-value 
                  button.btn-del(data-del-id='0')
                    img.btn-del_img.close-icon(src='./images/icons/icons.svg#close')
                    span.btn-del_text Delete
              td.table_cell(data-gr="100")
                span.table_cell-head Gr.
                span.table_cell-value.js-product-gr 100 
              td.table_cell.table_cell--min(data-pallet="1152")
                span.table_cell-head Pcs/Pallet
                span.table_cell-value 1152
              td.table_cell.table_cell--end(data-quant='0')
                p.counter.js-counter(data-num="0")
                  button.counter_minus(disabled="true") -
                  span.counter_num 0
                  button.counter_plus +
      a.shoping_btn.btn-three(href='./#catalog') + Add Product
      a.shoping_btn.shoping_btn--second.btn-base.js-goto-link(data-goto="order-block") Send wishlist