section.catalog-wrap#catalog
  .container
    .catalog
      h2.catalog_title.title-3 catalog
      ul.catalog-filter.js-cat-filter
        li.catalog-filter_item.btn-secondary(data-filter="all")
          img.catalog-filter_item-img(src='./images/icons/icons.svg#all')
          span.catalog-filter_item-text All
        li.catalog-filter_item.btn-secondary(data-filter="cottonProducts")
          img.catalog-filter_item-img(src='./images/icons/icons.svg#office')
          span.catalog-filter_item-text Office Supplies
        li.catalog-filter_item.btn-secondary(data-filter="dressingProducts")
