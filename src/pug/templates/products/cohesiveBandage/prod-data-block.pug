    .prod-data
      h2.prod-data_title.title-3 Our offer
      .prod-data_tables.js-tabs-content(data-tab-content="product")
        table.table.prod-data_table--vis
          thead.table_head
            tr.table_head-row
              th.table_head-cell.table_head-cell--start 
                span.table_head-caption Name
              th.table_head-cell 
                span.table_head-caption Art.
