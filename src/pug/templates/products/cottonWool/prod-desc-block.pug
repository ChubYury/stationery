section.prod-desc-wrap
  .container
    .prod-desc_decor 
    .prod-desc
      .prod-desc_content
        h3.prod-desc_title Cotton Wool
        .prod-desc_stand-box
          img.prod-desc_stand-logo(src='@img/iso-logo.svg' alt="quality standard logo")
          img.prod-desc_stand-logo(src='@img/ce-logo.png' alt="quality standard logo")
        .prod-desc_text Use in medical and cosmetic purposes. 100 % cotton. Packaging and design 
                      | per your special request. Different size range. Made in EU. All articles 
                      | and info are represented bellow in a table.
        .prod-desc_btn-box
          button.prod-desc_btn.btn-four.js-btn-tab(data-multi-tab="product" data-id="0")
            img.btn-four_icon.btn-four_icon--hover(src='./images/icons/icons.svg#zig-zag')
            img.btn-four_icon(src='./images/icons/icons.svg#zig-zag-blue')
            span Zig-Zag
          button.prod-desc_btn.btn-four.js-btn-tab(data-multi-tab="product" data-id="1")
            img.btn-four_icon.btn-four_icon--hover(src='./images/icons/icons.svg#roll')
            img.btn-four_icon(src='./images/icons/icons.svg#roll-blue')
            span Roll
          button.prod-desc_btn.btn-four#open-gallery-open(data-fancybox-trigger="gallery")
            img.btn-four_icon.btn-four_icon--hover(src='./images/icons/icons.svg#gallery')
            img.btn-four_icon(src='./images/icons/icons.svg#gallery-blue')
            span Photo Gallery
      .prod-desc_img-wrap
        img.prod-desc_img(src='@img/products/prod-1.jpg')
