section.prod-desc-wrap
  .container
    .prod-desc_decor 
    .prod-desc
      .prod-desc_content
        h3.prod-desc_title Eraser
        .prod-desc_stand-box
          img.prod-desc_stand-logo(src='@img/iso-logo.svg' alt="quality standard logo")
          img.prod-desc_stand-logo(src='@img/ce-logo.png' alt="quality standard logo")
        .prod-desc_text Whether it's sketches, drawings, or important notes, this eraser will help you 
                      | perfect your work. Its comfortable shape and high-quality material ensure 
                      | comfortable and precise erasing. 
        .prod-desc_btn-box
          button.prod-desc_btn.btn-four.js-btn-tab(data-multi-tab="product" data-id="0")
            img.btn-four_icon.btn-four_icon--hover(src='./images/icons/icons.svg#cheap-white')
            img.btn-four_icon(src='./images/icons/icons.svg#cheap')
            span Cheap
          button.prod-desc_btn.btn-four.js-btn-tab(data-multi-tab="product" data-id="1")
            img.btn-four_icon.btn-four_icon--hover(src='./images/icons/icons.svg#expensive-white')
            img.btn-four_icon(src='./images/icons/icons.svg#expensive')
            span Expensive
          button.prod-desc_btn.btn-four#open-gallery-open(data-fancybox-trigger="gallery")
            img.btn-four_icon.btn-four_icon--hover(src='./images/icons/icons.svg#gallery')
            img.btn-four_icon(src='./images/icons/icons.svg#gallery-blue')
            span Photo Gallery
      .prod-desc_img-wrap
        img.prod-desc_img(src='@img/products/prod-2-4.jpg')
