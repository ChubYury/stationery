section.prod-desc-wrap
  .container
    .prod-desc_decor 
    .prod-desc
      .prod-desc_content
        h3.prod-desc_title Orthopedic padding
        .prod-desc_stand-box
          img.prod-desc_stand-logo(src='@img/iso-logo.svg' alt="quality standard logo")
          img.prod-desc_stand-logo(src='@img/ce-logo.png' alt="quality standard logo")
        .prod-desc_text Product for medical, veterinarian purposes. Wide range of sizes. Non-sterile. 
                      | Welcome for private packing. Perfect quality according to all European standards.  
        .prod-desc_btn-box
          button.prod-desc_btn.btn-four#open-gallery-open(data-fancybox-trigger="gallery")
            img.btn-four_icon.btn-four_icon--hover(src='./images/icons/icons.svg#gallery')
            img.btn-four_icon(src='./images/icons/icons.svg#gallery-blue')
            span Photo Gallery
      .prod-desc_img-wrap
        img.prod-desc_img(src='@img/products/prod-2-5.webp')
